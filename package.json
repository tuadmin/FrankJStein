{
    "name": "frankjstein",
    "version": "0.6.4",
    "publishConfig": {
        "tag": "latest",
        "access": "public"
    },
    "description": "<⚡> Fragment Reactive Async Node Kit JavaScript Suspense Tree Engine Integrated Natively",
    "main": "dist/frankjstein.js",
    "types": "dist/frankjstein.d.ts",
    "type": "module",
    "scripts": {
        "test": "bun test tests/",
        "test:ia": "bun test tests-ia/",
        "test:all": "bun test",
        "lint": "biome lint .",
        "lint:fix": "biome check --apply .",
        "format": "biome format --write .",
        "build:addons": "rollup -c scripts/rollup.addons.mjs",
        "bench:router": "bun run benchmarks/turouter.js"
    },
    "exports": {
        ".": {
            "types": "./dist/frankjstein.d.ts",
            "import": "./dist/frankjstein.js"
        },
        "./turouter": {
            "types": "./dist/turouter.d.ts",
            "import": "./dist/turouter.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "devDependencies": {
        "@biomejs/biome": "^2.4.14",
        "@happy-dom/global-registrator": "^20.9.0",
        "@rollup/plugin-strip": "^3.0.4",
        "@rollup/plugin-terser": "^1.0.0",
        "@types/bun": "^1.3.13",
        "happy-dom": "^20.9.0",
        "rollup": "^4.60.3",
        "rollup-plugin-dts": "^6.4.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tuadmin/FrankJStein.git"
    },
    "keywords": [
        "framework",
        "reactive",
        "signals",
        "dom",
        "suspense",
        "async",
        "ui",
        "builder",
        "workers",
        "threads",
        "dependency-injection",
        "di",
        "ioc",
        "ai-agents",
        "llm",
        "agentic"
    ],
    "author": "Victor Choque",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/tuadmin/FrankJStein/issues"
    },
    "homepage": "https://github.com/tuadmin/FrankJStein#readme"
}